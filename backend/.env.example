# Application Settings
APP_NAME="Agentic RAG Backend"
APP_VERSION="1.0.0"
DEBUG=true

# New PostgreSQL Server (created in backend/.pgdata on port 5433)
DATABASE_URL="postgresql+psycopg2://postgres@localhost:5433/agentic_rag"
PG_HOST="localhost"
PG_PORT=5433
PG_USER="postgres"
PG_PASSWORD=""
PG_DATABASE="agentic_rag"

# Vector & Chunking Configuration
EMBEDDING_DIMENSION=384
CHUNK_SIZE=600
CHUNK_OVERLAP=100
DEFAULT_TOP_K=5

# LLM & Embedding Provider Configuration
# Supported LLM_PROVIDER: "auto" | "openai" | "gemini" | "ollama" | "local"
LLM_PROVIDER="ollama"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"

# CORS for future Next.js Frontend
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
